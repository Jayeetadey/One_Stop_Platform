# ─── SMTP Configuration (Gmail) ───
# These are placeholder values. Replace with your actual Gmail credentials.
# For SMTP_PASS, use a Google App Password, NOT your Gmail login password.
# Generate one at: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_google_app_password

# ─── Application & Auth ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=your_random_32_character_secret_key

