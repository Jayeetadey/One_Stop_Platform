# ─── SMTP Configuration (Gmail) ───
# For SMTP_PASS, use a Google App Password, NOT your regular Gmail account password.
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password_16_characters

# ─── Application & Session Authentication ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=your_secure_random_32_character_server_secret_key

# ─── Upstash Redis (Optional for persistent OTP & Redis Rate Limiting) ───
# If unconfigured, the application automatically uses a secure in-memory cache.
# Get free credentials at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ─── High-Speed Groq Cloud Inference (Unified LPU Fallback) ───
# Powering ultra-fast answers across all models on Groq LPU
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Official AI Provider API Keys ───
# Add your official keys to query the official endpoints directly
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Google Gemini API Keys
GOOGLE_AI_KEY=your_google_ai_studio_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_KEY_ALT=your_backup_google_ai_key_here

# xAI / Grok API Keys
XAI_API_KEY=xai-your_xai_api_key_here
GROK_API_KEY=your_grok_key_here

# Perplexity / Sonar Pro API Keys
PERPLEXITY_API_KEY=pplx-your_perplexity_api_key_here
SONAR_API_KEY=your_sonar_key_here

# ─── Firebase Client Configuration (Optional for client-side Auth/Firestore) ───
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
